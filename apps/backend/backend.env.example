# Process environment variables take precedence over this file.
# No credentials are required for local account/session development.
# LINKA_DATA_DIR=C:/absolute/path/to/linka-state
# LINKA_CONFIG_FILE=C:/absolute/path/to/backend.local.json
# LINKA_AUTOMOD_CONFIG=C:/absolute/path/to/automoderator.json

# Optional administration and synchronization secrets; set your own values.
# ADMIN_MASTER_KEY=
# SECRET_KEY=
# LINKA_GATE_SECRET=

# Optional media storage. Both keys are needed for media operations.
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# B2_BUCKET=linka-media
MY_DOMINIO_PROXY=http://127.0.0.1:5000

# Optional bridge credentials (use this file for all bridges).
# MASTODON_KEY=
# BSKY_HANDLE=
# BSKY_APP_PASSWORD=
# token_gmail=
